[importlinter]
# src.connectors и src.sender - namespace-каталоги без __init__.py: без перечисления
# их "порций" grimp не видит эти модули, и контракт молча проходит при реальных нарушениях.
root_packages =
    src
    src.connectors
    src.sender
include_external_packages = False

[importlinter:contract:brain-no-adapters]
name = use-cases (brain) не импортируют адаптеры
type = forbidden
source_modules =
    src.brain
forbidden_modules =
    src.connectors
    src.calendar
    src.parser
    src.sender
    src.collector
    src.notifier
# Считаются только прямые импорты: иначе цепочки через чужие модули
# (bot_handler -> live_ticker -> connectors) тянут в Фазу 2 рефакторинг live_ticker.
allow_indirect_imports = True
ignore_imports =

[importlinter:contract:bot-handler-no-adapters]
name = bot_handler не импортирует адаптеры
type = forbidden
source_modules =
    src.notifier.bot_handler
forbidden_modules =
    src.connectors
    src.calendar
    src.parser
    src.sender
    src.collector
allow_indirect_imports = True
ignore_imports =
    # долг, только убывает: bot_handler.py:1052,1095,1144, inline-импорты внутри функций, уберёт Фаза 2 (PRT-04)
    src.notifier.bot_handler -> src.connectors.aadhk.parser
    # долг, только убывает: bot_handler.py:1143, inline-импорт внутри функции, уберёт Фаза 2 (PRT-04)
    src.notifier.bot_handler -> src.connectors.gdrive.client
    # долг, только убывает: bot_handler.py:23, top-level импорт, уберёт Фаза 2 (PRT-04)
    src.notifier.bot_handler -> src.connectors.guap_lms.client
    # долг, только убывает: bot_handler.py:22, top-level импорт, уберёт Фаза 2 (PRT-04)
    src.notifier.bot_handler -> src.sender.email_sender

# Ядро импортирует только stdlib и src.core.* (D-01): список запретов = все прочие модули
# верхнего уровня src; полноту списка проверяет tests/test_core_architecture.py.
[importlinter:contract:core-is-pure]
name = ядро (core) не зависит от адаптеров, use-cases и корня композиции
type = forbidden
source_modules =
    src.core
forbidden_modules =
    src.connectors
    src.calendar
    src.parser
    src.sender
    src.collector
    src.notifier
    src.brain
    src.storage
    src.models
    src.main
    src.detector
    src.config
    src.composition
allow_indirect_imports = True
ignore_imports =
