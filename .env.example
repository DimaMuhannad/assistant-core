TZ=Europe/Moscow
DEBUG=False
DATABASE_URL=sqlite+aiosqlite:///./data/assistant.db
SCHEDULE_URL=https://rasp.guap.ru/
SCHEDULE_TARGET_ID=1234
SCHEDULE_POLL_INTERVAL_HOURS=2
GOOGLE_CREDENTIALS_FILE=./credentials.json
GOOGLE_TOKEN_FILE=./token.json
GOOGLE_CALENDAR_ID=primary_or_secondary_calendar_id@group.calendar.google.com
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz
TELEGRAM_USER_ID=987654321
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# --- Журнал активности проектов в Notion ---
# Значения задаются в собственном файле .env. Секреты в чат не присылаются.
# NOTION_API_KEY=
# NOTION_ACTIVITY_DB_ID=

# --- Почта (сбор писем) ---
# Внимание: содержимое писем обрабатывается внешними ИИ-сервисами.
# Разработчик не отвечает за утечку секретов и личной информации из писем.
# Не подключайте ящики, содержимое которых нельзя передавать третьим лицам.
# Значения задайте в своём файле .env, а не здесь.
# MAILRU_EMAIL=
# MAILRU_PASSWORD=
# GMAIL_EMAIL=
# GMAIL_PASSWORD=
